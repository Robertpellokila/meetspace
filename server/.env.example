PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin: choose one credential source, using the same project as client.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Alternatively, supply the service-account JSON as a server-only environment secret:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Cloudflare Workers require FIREBASE_SERVICE_ACCOUNT_JSON as a runtime secret.
# GOOGLE_APPLICATION_CREDENTIALS is only for the local Node server.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Firebase Authentication UID(s), comma-separated. Never use client input/email to set admin.
ADMIN_UIDS=

# Random secret (at least 32 characters) used to hash client IPs in shared
# Firestore rate-limit counters. Required for registration/meeting-ID/waiting-room APIs.
RATE_LIMIT_SECRET=
# Hanya true bila semua request masuk lewat Cloudflare; Worker sudah mengaturnya.
RATE_LIMIT_TRUST_CF_IP=false

# Configure the LiveKit webhook URL in your project: https://YOUR_BACKEND/api/webhooks/livekit
# Events: room_started, room_finished, participant_joined, participant_left.
